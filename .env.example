# Copy to .env and fill in what you use. The backend loads it on startup.

# Recommendation provider for new users: devin or nebius
RECOMMENDATION_PROVIDER=devin

# Devin (https://app.devin.ai/settings/devin-api?tab=service-users)
DEVIN_API_KEY=
DEVIN_ORG_ID=

# Nebius Token Factory (https://tokenfactory.nebius.com, Get API key)
NEBIUS_API_KEY=
NEBIUS_MODEL=Qwen/Qwen3.5-397B-A17B
NEBIUS_THINKING=off

# Voice input via slng.ai
SLNG_API=

# Trailer stream quality in live mode: DEF_480p (default), DEF_SD, DEF_720p
# REELPICK_TRAILER_DEFINITION=DEF_480p

# Optional
# PUBLIC_BASE_URL=
# REELPICK_DB_PATH=data/reelpick.db
